# BIST AI Yatırım Terminali — Environment Değişkenleri

# Turso Veritabanı (ZORUNLU)
# turso db create borsa-app
# turso db tokens create borsa-app
TURSO_DATABASE_URL=libsql://borsa-app-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# E-posta bildirimleri (Gmail SMTP) — zorunlu DEĞİL.
# Tanımlıysa: zarar/kâr hedefi uyarıları e-posta ile de gönderilir.
# Tanımlı değilse: tarayıcı bildirimleri çalışmaya devam eder, e-posta gönderilmez (sahte gönderim yapılmaz).
# Gmail App Password oluşturma: Google Hesabı > Güvenlik > 2 Adımlı Doğrulama > Uygulama Şifreleri
GMAIL_USER=kullanici@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# E-posta şifreleme anahtarı (opsiyonel, varsayılan gizli anahtar kullanılır)
# MAIL_SECRET=your-secret-key

# Midas canlı veri API'si (opsiyonel)
# Tanımlandığında otomatik devreye girer.
# MIDAS_API_KEY=your-midas-api-key
